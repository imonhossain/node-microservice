# Backend (NestJS)
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200

# PostgreSQL (used by both docker-compose and the NestJS app)
DB_HOST=localhost
DB_PORT=5435  # host port; container always listens on 5432 internally
DB_USERNAME=syncra
DB_PASSWORD=syncra
DB_NAME=syncra

# Frontend (Vite) — prefix with VITE_ to expose to the client bundle
VITE_API_URL=http://localhost:3000/api

AUTH_CLIENT_ID=
CLIENT_SECRETS=
AUTH_SECRET=
