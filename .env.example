# Backend (NestJS)
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200

# PostgreSQL (used by both docker-compose and the NestJS app)
DB_HOST=localhost
DB_PORT=5435  # host port; container always listens on 5432 internally
DB_USERNAME=syncra
DB_PASSWORD=syncra
DB_NAME=syncra

# Frontend (Vite) — prefix with VITE_ to expose to the client bundle
VITE_API_URL=http://localhost:3000/api

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

AUTH_SECRET=replace-with-openssl-rand-hex-32


# Database (already there from Day 2, but make sure)
DATABASE_URL=postgresql://syncra:syncra@localhost:6432/syncra
APP_DATABASE_URL=postgresql://app_user:app_user@localhost:6432/syncra

SMTP_HOST=localhost
SMTP_PORT=1025
APP_ORIGIN=http://localhost:4200