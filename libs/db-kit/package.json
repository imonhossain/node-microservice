{
  "name": "@syncra/db-kit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "types":       "./dist/index.d.ts",
      "default":     "./dist/index.js"
    },
    "./schema": {
      "@org/source": "./src/schema/index.ts",
      "types":       "./dist/schema/index.d.ts",
      "default":     "./dist/schema/index.js"
    },
    "./migrate": {
      "@org/source": "./src/migrate.ts",
      "types":       "./dist/migrate.d.ts",
      "default":     "./dist/migrate.js"
    }
  },
  "scripts": {
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:check":    "drizzle-kit check",
    "db:migrate":       "tsx src/migrate.ts",
    "db:reset":         "tsx bin/reset.ts && npm run db:migrate",
    "test":             "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.0",
    "vitest": "^2.1.0",
    "@testcontainers/postgresql": "^10.13.0",
    "testcontainers": "^10.13.0"
  }
}